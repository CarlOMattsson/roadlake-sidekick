# Local seed data configuration, read by `python -m tools.seed`.
#
# Copy to .env.seed and adjust when needed. Every value has a working default, so
# the file is optional. Set these only in .env.seed: as process environment variables they
# do not work, because the application's own settings reject any SIDEKICK_ variable they
# do not declare, and the seeder loads those settings first.
#
# Kept separate from .env on purpose: sidekick.shared.config.Settings forbids unknown
# keys, so an extra key in .env would stop the backend from starting.

# Local login that owns all seeded data. Created only if it is missing.
SIDEKICK_SEED_LOGIN=local-user
SIDEKICK_SEED_DISPLAY_NAME=Local User
