# Postgres bootstrap and migrator credentials for the self-hosted stack.
# Copy to db.env (gitignored), replace every value that starts with "replace-with-", and keep chmod 600.
#
# Read only by the postgres and migrate services. The api container never receives this file, so the
# migrator role is not reachable from the running application (the runtime must never run DDL).
#
# Generate each password with: openssl rand -hex 32
# Hex is used on purpose: the passwords are embedded in URLs and must need no escaping.

# Superuser of the self-hosted instance, used only for first-start bootstrap by the postgres image.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Read by deploy/selfhost/postgres-init.sh on the first start, when the data volume is empty.
# The app value must equal the password inside SIDEKICK_DATABASE_URL in selfhost.env.
SIDEKICK_DB_APP_PASSWORD=replace-with-openssl-rand-hex-32
SIDEKICK_DB_MIGRATOR_PASSWORD=replace-with-openssl-rand-hex-32

# Used by the one-shot migrate service: yoyo apply as sidekick_migrator, which is a member of sidekick_owner.
SIDEKICK_MIGRATION_DATABASE_URL=postgresql+psycopg://sidekick_migrator:replace-with-same-as-SIDEKICK_DB_MIGRATOR_PASSWORD@postgres:5432/sidekick
