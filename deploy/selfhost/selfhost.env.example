# Sidekick self-hosted runtime configuration. The api container reads the whole file; each worker receives only the
# SIDEKICK_ settings it uses, named in compose.yaml (see docs/operate/limits-and-secrets.md).
# Copy to selfhost.env (gitignored), replace every value that starts with "replace-with-", and keep chmod 600.
#
# Every SIDEKICK_ name in this file must be a declared setting in backend/src/sidekick/shared/config/.
# An undeclared SIDEKICK_ variable stops the api from starting (extra="forbid"). Keep database role
# passwords, the migrator URL and anything else that belongs to db.env out of this file.
#
# Secrets: openssl rand -base64 48   (database passwords: openssl rand -hex 32, see db.env.example)
# Check for leftovers before starting (this must print nothing; plain 'replace-with-' also matches comments):
#   grep -nE '^[A-Z_]+=.*replace-with-' selfhost.env db.env
# The one line that may still say replace-with- before "First start" in README.md is
# SIDEKICK_MCP_OAUTH_ALLOWED_IDENTITIES: it needs the user id that `sidekick-admin create-user` prints, and that command
# does not validate it (only the api itself requires a complete OAuth policy).
#
# WARNING: never put SIDEKICK_API_IMAGE (or any other compose-only SIDEKICK_ variable) in this file. The whole file
# is the api container's env_file, and the api refuses to start on an undeclared SIDEKICK_ variable
# ("undeclared SIDEKICK_ setting environment variables"). The image pin belongs in release.env (written by
# update.sh), passed as a second --env-file for every compose command, `up` included:
#   docker compose --env-file selfhost.env --env-file release.env up -d

# Secrets as files (optional, recommended). A secret in this file is an environment variable of the api container, visible
# to every process in it and to `docker inspect`. Moved to a file it is mounted read-only at /run/secrets/<name> in
# only the services that read it, and the backend reads it through SIDEKICK_<NAME>_FILE (compose.yaml sets that).
# Existing installations keep working unchanged; move the values when you like, without printing them:
#   sh secrets-to-files.sh --dry-run      what it would do
#   sh secrets-to-files.sh                writes secrets/<name> (directory mode 700, files mode 644: the container user is
#                                         not you and Compose ignores a file's mode, so the directory keeps others out),
#                                         removes the SIDEKICK_<NAME>= line from this file and adds the line below
# A fresh install can skip the SIDEKICK_<NAME>= lines for the secrets below, write each value to its file yourself
# (printf '%s\n' VALUE > secrets/NAME, nothing else in the file) and set the SELFHOST_ line. Setting both
# SIDEKICK_<NAME> and its file stops the api at startup. The names below are Compose's, not settings: the api ignores them.
#SELFHOST_DATABASE_URL_FILE=./secrets/database_url
#SELFHOST_CURSOR_SIGNING_SECRET_FILE=./secrets/cursor_signing_secret
#SELFHOST_TOKEN_PEPPER_FILE=./secrets/token_pepper
#SELFHOST_MCP_OAUTH_GITHUB_CLIENT_SECRET_FILE=./secrets/mcp_oauth_github_client_secret
#SELFHOST_MCP_OAUTH_SIGNING_KEY_FILE=./secrets/mcp_oauth_signing_key
#SELFHOST_MEMORY_HINDSIGHT_API_TOKEN_FILE=./secrets/memory_hindsight_api_token
#SELFHOST_MEMORY_ID_DERIVATION_KEY_FILE=./secrets/memory_id_derivation_key
#SELFHOST_BACKUP_ENCRYPTION_KEY_FILE=./secrets/backup_encryption_key
#SELFHOST_PUSH_AUTH_TOKEN_FILE=./secrets/push_auth_token

# Public host name. Caddy (VPS profile) serves and certifies it. On a home machine behind a tunnel use the tunnel's
# host name here too: compose still needs a value to parse the file. Not a SIDEKICK_ name, so the api never reads it.
SELFHOST_DOMAIN=replace-with-your-domain.example

# Pinned to production in compose.yaml as well. Production refuses placeholder secrets (see below).
SIDEKICK_ENVIRONMENT=production

# App role only (sidekick_app). The password must equal SIDEKICK_DB_APP_PASSWORD in db.env.
# Host "postgres" is the compose service on the internal data network.
SIDEKICK_DATABASE_URL=postgresql+psycopg://sidekick_app:replace-with-same-as-SIDEKICK_DB_APP_PASSWORD@postgres:5432/sidekick

# SIDEKICK_CURSOR_SIGNING_SECRET signs list cursors; SIDEKICK_TOKEN_PEPPER hashes personal and companion tokens, so changing it
# makes every issued token invalid. Production rejects values starting with "development-" or "replace-with-"; use at
# least 32 characters.
SIDEKICK_CURSOR_SIGNING_SECRET=replace-with-openssl-rand-base64-48
SIDEKICK_TOKEN_PEPPER=replace-with-openssl-rand-base64-48

# Public MCP authentication through GitHub OAuth. Fails closed unless every line below is valid.
# SIDEKICK_MCP_PUBLIC_BASE_URL is a bare HTTPS origin: no path, no trailing slash, no query.
SIDEKICK_MCP_AUTH_MODE=github_oauth
SIDEKICK_MCP_PUBLIC_BASE_URL=https://replace-with-your-domain.example
# GitHub OAuth App created by the owner. Callback URL in GitHub: <public origin>/mcp/auth/callback
SIDEKICK_MCP_OAUTH_GITHUB_CLIENT_ID=replace-with-github-oauth-app-client-id
SIDEKICK_MCP_OAUTH_GITHUB_CLIENT_SECRET=replace-with-github-oauth-app-client-secret
# Signing key for Sidekick's own OAuth tokens. Generate: openssl rand -base64 48
SIDEKICK_MCP_OAUTH_SIGNING_KEY=replace-with-openssl-rand-base64-48
# Encrypted client storage. Must be absolute and writable by the api user. The compose volume is
# mounted at /var/lib/sidekick; if the api user cannot write to it, fix the volume's ownership first.
SIDEKICK_MCP_OAUTH_STORAGE_DIR=/var/lib/sidekick/oauth-storage
# One or more identities, comma separated: github:<numeric GitHub id>=<sidekick user uuid>
# The numeric id is the GitHub user id, not the login (curl -s https://api.github.com/users/<login>, field "id").
# The uuid is printed by `sidekick-admin create-user`, which works before this line is filled in: see "First start"
# in README.md. Anyone not listed is refused. Remove a line and restart the api to withdraw access.
SIDEKICK_MCP_OAUTH_ALLOWED_IDENTITIES=github:replace-with-numeric-github-id=replace-with-sidekick-user-uuid
# Scopes an OAuth session holds, whatever the client asks for. Must be a subset of: projects, tasks, contacts, journal,
# shopping, automation, each with :read or :write (list both when Claude should read and change). The example has no
# journal scope: add journal:read (and journal:write) for the Journal room. Start narrow; widen deliberately (a :write scope lets the connected
# client change your data; automation:* is for the automations room and is never granted by default).
SIDEKICK_MCP_OAUTH_SCOPES=projects:read,tasks:read,contacts:read,shopping:read
# How long a successful GitHub token check is remembered, in seconds (default 300, at most 3600; 0 = ask GitHub on
# every request). A revoked GitHub grant keeps working this long; recreating the api container empties that memory (it is
# in-process). To lock a person out at once and for good, run `sidekick-admin disable-user` (see README.md, "Connect Claude").
#SIDEKICK_MCP_OAUTH_UPSTREAM_CACHE_SECONDS=300
# How many days a new sign-in lasts before Claude has to sign in again (default 30, at most 90). Sign-ins that already
# exist keep the lifetime they were given.
#SIDEKICK_MCP_OAUTH_SESSION_DAYS=30
# Total seconds a public request body may take to arrive (default 30; the OAuth forms 10; each above 0, at most 300).
# A client that drips bytes gets 408 instead of holding a worker. Raise only if a legitimate client on a very slow link
# is refused.
#SIDEKICK_BODY_READ_TIMEOUT_SECONDS=30
#SIDEKICK_OAUTH_BODY_READ_TIMEOUT_SECONDS=10
# Overload guards (in memory). Most request bodies that may still be arriving at once (default 32; 1 to 1024; each up to
# 1 MiB): beyond it a request gets 503 with Retry-After. Failed bearer attempts (401) per client address and in total per
# minute (defaults 10 and 60): beyond them requests with an unknown token get 429 before any database query; tokens the
# API verified within the last hour are never throttled, and a reserve of unknown-token requests per minute (default 5,
# 0 = off) always gets through so the owner's first call after a restart is not locked out. Behind a tunnel all visitors
# share one address, so the global value and the reserve are what apply.
#SIDEKICK_MAX_BUFFERED_REQUESTS=32
#SIDEKICK_FAILED_AUTH_PER_CLIENT_PER_MINUTE=10
#SIDEKICK_FAILED_AUTH_GLOBAL_PER_MINUTE=60
#SIDEKICK_FAILED_AUTH_RESERVE_PER_MINUTE=5
# Left at their defaults on purpose: SIDEKICK_MCP_OAUTH_ALLOWED_REDIRECT_URIS (Claude's callback)
# and SIDEKICK_MCP_OAUTH_ENABLE_CIMD=false.

# Memory (profile `memory`: memory-worker and hindsight). Off by default: nothing is derived or sent anywhere until
# you turn it on.
#
# Hindsight's own settings and secrets are NOT here but in hindsight.env (copy of hindsight.env.example), because this
# file is also the api's env_file. Hindsight sends the memory material to the language model provider named there.
SIDEKICK_MEMORY_ENABLED=false
SIDEKICK_MEMORY_PROVIDER=fake
# Turn these on together with the memory profile, then set SIDEKICK_MEMORY_ENABLED=true:
# SIDEKICK_MEMORY_PROVIDER=hindsight
# SIDEKICK_MEMORY_HINDSIGHT_BASE_URL=http://hindsight:8888
# The token must equal HINDSIGHT_API_TENANT_API_KEY in hindsight.env:
# SIDEKICK_MEMORY_HINDSIGHT_API_TOKEN=replace-with-openssl-rand-base64-48
# SIDEKICK_MEMORY_ID_DERIVATION_KEY=replace-with-openssl-rand-base64-48
# Hindsight refuses to start unless HINDSIGHT_API_RETAIN_CHUNK_SIZE is below HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS
# (in hindsight.env, example 3000 below 4000). Keep the chunk size under the completion limit when you change either.

# Database time budgets for the api and every worker (the defaults suit most installs). A query, lock wait or idle
# transaction that exceeds its budget is cancelled with an error instead of hanging; a worker logs it and tries again in
# its next cycle. Milliseconds, 0 = no limit. Backup, export and import processes ignore the statement and idle budgets,
# and migrations run on their own migrator connection with no budget, so a long one is never cut short.
SIDEKICK_DB_CONNECT_TIMEOUT_SECONDS=10
SIDEKICK_DB_STATEMENT_TIMEOUT_MS=30000
SIDEKICK_DB_LOCK_TIMEOUT_MS=5000
SIDEKICK_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# Encrypted backups run only with `--profile backup`. That profile sets SIDEKICK_BACKUP_ENABLED=true and
# SIDEKICK_BACKUP_DIRECTORY=/var/lib/sidekick/backups itself. Here you set the key and the retention.
# The key must be a Fernet key, not an openssl value. Generate it without starting anything else:
#   docker compose --env-file selfhost.env run --rm --no-deps api sidekick-backup keygen
# Keep a copy outside the server: a lost key means neither the backups nor the update snapshots can be decrypted.
SIDEKICK_BACKUP_ENABLED=false
# Uncomment and replace before using the backup profile. Without it the backup service refuses to start.
# SIDEKICK_BACKUP_ENCRYPTION_KEY=replace-with-fernet-key-from-sidekick-backup-keygen
# Keep 14 backups, and delete older ones. Seconds between backups (3600 to 604800).
SIDEKICK_BACKUP_RETENTION_COUNT=14
SIDEKICK_BACKUP_RETENTION_DAYS=14
# The newest N finished backups are never pruned, however old. A new backup needs this percentage
# (at least 100) of the newest backup's size free in its directory, and at least 64 MiB, or it refuses.
# (update.sh and the host scripts read SIDEKICK_BACKUP_SPACE_MARGIN_PCT and SIDEKICK_SNAPSHOT_KEEP from their own environment.)
SIDEKICK_BACKUP_MIN_KEEP=5
SIDEKICK_BACKUP_SPACE_MARGIN_PCT=150
SIDEKICK_BACKUP_INTERVAL_SECONDS=86400

# Push to the Android companion. Off by default: nothing is queued and the worker sends nothing.
# To turn it on set SIDEKICK_COMPANION_ENABLED=true and SIDEKICK_PUSH_ENABLED=true here (api and the worker both
# read this file), then start the worker with `--profile push`. It must keep running: the worker can queue the morning
# summary during the two hours after the configured time, and a summary missed beyond that is skipped, not made up
# later. The push body carries no content; the phone fetches it.
SIDEKICK_COMPANION_ENABLED=false
SIDEKICK_PUSH_ENABLED=false
# Hosts a device may register as its push endpoint (comma-separated, https only). The default is the public
# ntfy.sh; the phone's ntfy app decides which server a registration uses (its "default server" setting).
SIDEKICK_PUSH_ALLOWED_HOSTS=ntfy.sh
# Own ntfy server, started by `--profile push` and published by Caddy (profile `vps`) on the same domain under /up...
# A home machine behind a tunnel has no Caddy, so it stays on ntfy.sh. The server keeps messages in memory for two
# hours and nothing on disk; its daily limit is 2 000 messages (ntfy/server.yml).
# 1. Run `sh deploy/selfhost/ntfy-init.sh` once. It writes ntfy.env, ntfy-secrets/sidekick-token and
#    ntfy-secrets/phone-password (all mode 600) and prints only where they are, never their content.
# 2. Put the host name in the allowlist (keep ntfy.sh to fall back), name it as the host that gets the token, and
#    paste the token from ntfy-secrets/sidekick-token. The worker sends it only to SIDEKICK_PUSH_AUTH_HOST,
#    never to ntfy.sh. Leave the three lines commented out to deliver through ntfy.sh as before.
# SIDEKICK_PUSH_ALLOWED_HOSTS=replace-with-your-domain.example,ntfy.sh
# SIDEKICK_PUSH_AUTH_HOST=replace-with-your-domain.example
# SIDEKICK_PUSH_AUTH_TOKEN=replace-with-token-from-ntfy-secrets-sidekick-token
# Reminder times and "today" count in the owner's zone, an IANA name (default Europe/Stockholm).
# SIDEKICK_OWNER_TIMEZONE=Europe/Stockholm
# Language of the apps and of Claude's answers: sv (Swedish, the default) or en (English). Choose it on purpose.
# SIDEKICK_MCP_APP_LOCALE=sv
# The rooms shown (comma-separated: work, journal, shopping, contacts, control; work cannot be left out). Default: all.
# SIDEKICK_ENABLED_ROOMS=work,journal,shopping,contacts,control
# Seconds between looks at the outbox.
SIDEKICK_PUSH_POLL_SECONDS=5
# Minimum seconds between wake pushes to one subscription (ntfy.sh free tier: ~250 messages/day per IP; the own
# ntfy has no such quota, so this can be lowered there); reminders are not delayed.
SIDEKICK_PUSH_WAKE_MIN_INTERVAL_SECONDS=20
SIDEKICK_PUSH_SUMMARY_TIME=08:00
SIDEKICK_PUSH_DUE_LEAD_MINUTES=15
SIDEKICK_PUSH_QUIET_START=21:00
SIDEKICK_PUSH_QUIET_END=07:00

# Resource limits (optional; the values shown are the defaults, so leave the lines commented out unless you need to change
# one). Compose reads these names from this file, they are not SIDEKICK_ settings and the api ignores them. Memory is a
# ceiling in b, k, m or g, not a reservation; a container that exceeds it is killed and restarted, and `docker inspect`
# shows OOMKilled. The process limit stops a runaway process from filling the host's process table.
# backup and api default to 3g because a backup holds up to 512 MiB of plaintext in memory several times over while it is
# encrypted, and update.sh and restore.sh run those steps in the api image. Lower them only on a small host with a small
# database. hindsight (4g) is an estimate, not a measurement, because the local embedding models run in it.
#SELFHOST_POSTGRES_MEM_LIMIT=1g
#SELFHOST_POSTGRES_PIDS_LIMIT=256
#SELFHOST_MIGRATE_MEM_LIMIT=512m
#SELFHOST_MIGRATE_PIDS_LIMIT=64
#SELFHOST_API_MEM_LIMIT=3g
#SELFHOST_API_PIDS_LIMIT=256
#SELFHOST_AUTOMATION_MEM_LIMIT=512m
#SELFHOST_AUTOMATION_PIDS_LIMIT=64
#SELFHOST_BACKUP_MEM_LIMIT=3g
#SELFHOST_BACKUP_PIDS_LIMIT=64
#SELFHOST_PUSH_MEM_LIMIT=512m
#SELFHOST_PUSH_PIDS_LIMIT=64
#SELFHOST_MEMORY_MEM_LIMIT=512m
#SELFHOST_MEMORY_PIDS_LIMIT=64
#SELFHOST_HINDSIGHT_MEM_LIMIT=4g
#SELFHOST_HINDSIGHT_PIDS_LIMIT=512

# Update reminder, offline: the app counts the age of the running code and marks its ⋯ menu and Control after this many
# days. 0 turns it off. The date comes from the file SIDEKICK_BUILD_INFO_FILE names (JSON: commit, and updated_at or else
# built_at), else from the image (the build args SIDEKICK_BUILD_COMMIT and SIDEKICK_BUILD_DATE, the commit date), else
# from a git checkout; if none is known, no reminder. A locally built image only knows them if you set both in the shell
# before `docker compose build` (README.md, "First start").
# SIDEKICK_UPDATE_REMINDER_DAYS=14

# License keys are checked offline against the licensor's public key (base64 raw Ed25519). Until the build carries that
# key (sidekick/license/public_key.py) every key counts as unlicensed. Setting this here takes precedence over that
# constant. It is a public key, not a secret; you, the operator of the instance, never generate or sign keys.
# SIDEKICK_LICENSE_PUBLIC_KEY=
