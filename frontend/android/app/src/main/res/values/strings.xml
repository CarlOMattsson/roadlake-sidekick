    <string name="widget_notice_expired">En ibockad uppgift skickades aldrig. Kontrollera listan.</string>
    <string name="widget_open_task">Öppna uppgiften: %1$s</string>

    <!-- Shown instead of a blank page when the installed WebView is too old (WebViewRequirement). %1$d is the required version, %2$d the installed one. -->
    <string name="webview_too_old_title">Systemets webbvy är för gammal</string>
    <string name="webview_too_old_body">Sidekick behöver Android System WebView (version %1$d eller senare), men den här telefonen har version %2$d. Uppdatera Android System WebView (och Google Chrome) i appbutiken och öppna Sidekick igen.</string>
    <string name="webview_too_old_update">Uppdatera webbvyn</string>

    <!-- Notification channels (D-078). -->
    <string name="channel_reminders">Aviseringar</string>
    <string name="channel_sync">Synk</string>

    <!-- Visible reminders (D-078, D-079). The lock screen shows only the plural, never a title. -->
    <plurals name="reminder_today">
        <item quantity="one">%1$d uppgift idag</item>
        <item quantity="other">%1$d uppgifter idag</item>
    </plurals>
    <plurals name="reminder_overdue">
        <item quantity="one">%1$d försenad uppgift</item>
        <item quantity="other">%1$d försenade uppgifter</item>
    </plurals>
    <!-- Joins the non-zero parts of the morning summary ("3 uppgifter idag · 1 försenad uppgift"). -->
    <string name="reminder_summary_join">%1$s · %2$s</string>
    <string name="reminder_due_at">förfaller %1$s</string>
    <string name="reminder_test">Testavisering från Sidekick</string>
    <plurals name="reminder_public_title">
        <item quantity="one">Sidekick · %1$d avisering</item>
        <item quantity="other">Sidekick · %1$d aviseringar</item>
    </plurals>

    <!-- Widget picker preview: made-up tasks. The picker draws in the system language, so these have a values-en variant. -->
    <string name="widget_preview_title">Idag</string>
    <string name="widget_preview_task_1">Exempeluppgift</string>
    <string name="widget_preview_task_2">Exempeluppgift</string>
    <string name="widget_preview_overdue">Försenad</string>
