<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name" translatable="false">Sidekick</string>
    <string name="title_activity_main" translatable="false">Sidekick</string>
    <string name="package_name" translatable="false">com.roadlake.sidekick</string>
    <string name="custom_url_scheme" translatable="false">com.roadlake.sidekick</string>

    <!-- Today widget (Swedish is the default language of the app; values-en has the English texts). -->
    <string name="widget_title">Idag</string>
    <string name="widget_description">Dagens uppgifter från Sidekick. Bocka av direkt från hemskärmen.</string>
    <string name="widget_open_today">Öppna Idag i Sidekick</string>
    <string name="widget_refresh">Uppdatera</string>
    <string name="widget_not_paired">Koppla Sidekick</string>
    <string name="widget_not_paired_hint">Se dagens uppgifter här.</string>
    <string name="widget_pair_button">Koppla</string>
    <string name="widget_loading">Hämtar dagens uppgifter…</string>
    <string name="widget_empty">Inget kvar att göra idag.</string>
    <string name="widget_more">+%1$d till</string>
    <string name="widget_synced">Synkad %1$s</string>
    <string name="widget_offline_synced">Offline · synkad %1$s</string>
    <string name="widget_pending">Skickas…</string>
    <string name="widget_pending_description">Skickas: %1$s</string>
    <string name="widget_done_undo">Klar · Ångra</string>
    <string name="widget_undo_description">Ångra: %1$s</string>
    <string name="widget_overdue">Försenad</string>
    <string name="widget_complete">Markera som klar: %1$s</string>
    <string name="widget_notice_conflict">Ändrad på annat håll. Listan är uppdaterad.</string>
