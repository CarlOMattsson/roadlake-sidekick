<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis stays 0: refreshing is WorkManager's job (every 30 minutes, inexact), see TodaySync. -->
<!-- Default size 4x2 (the launcher cell formula 70n-30 dp gives 250 wide); the user can resize it. The minimum height holds the
     header, one row and the "+N till" footer, all 48 dp touch targets (TodayWidget.sizedHeights). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/widget_preview"
    tools:targetApi="31"
    android:minWidth="250dp"
    android:minHeight="162dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="162dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
