{
  "name": "sidekick-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "npm run build:mcp-app && npm run build:mobile",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:tool-types": "node scripts/generate-tool-types.mjs",
    "check": "node scripts/check.mjs",
    "check:bail": "node scripts/check.mjs --bail",
    "test:e2e": "npm run test:mcp-app && npm run test:mobile-audit",
    "build:mcp-app": "vite build --config vite.mcp-app.config.ts --mode sidekick",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "test:mcp-app": "playwright test --config playwright.mcp-app.config.ts",
    "test:mcp-app:preact": "vitest run --config vitest.mcp-app-preact.config.ts",
    "test:real-backend": "playwright test --config playwright.real-backend.config.ts",
    "test:mobile-audit": "playwright test --config playwright.mobile-audit.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "preact": "11.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "9.39.4",
    "@fontsource-variable/roboto": "5.3.0",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.4.0",
    "jsdom": "29.0.0",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@10.9.4"
}
