{
  "name": "roadlake-sidekick-website",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "build": "npm run sync && astro build",
    "preview": "astro preview --port 4321",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run check:links && npm run check:html && npm run check:site && npm run check:pricing",
    "check:links": "python3 scripts/check-links.py dist",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:site": "playwright test",
    "check:pricing": "python3 scripts/check-pricing.py"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.61.1",
    "html-validate": "11.21.0",
    "starlight-links-validator": "0.27.0"
  }
}
