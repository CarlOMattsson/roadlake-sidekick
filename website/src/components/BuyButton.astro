---
// The store button. Until pricing.json has a store URL it is an inactive "Soon" button: no link, nothing to buy yet.
import Icon from './Icon.astro';
import pricing from '../data/pricing.json';
const t = Astro.locals.t;
const url = pricing.storeUrl;
---
{
  url ? (
    <a class="btn btn--primary" href={url} rel="noopener">
      {t('site.pricing.buyButtonPolar')} <Icon name="external" size={18} />
      <span class="sr-only">{t('site.pricing.opensPolar')}</span>
    </a>
  ) : (
    <button type="button" class="btn btn--primary" aria-disabled="true">{t('site.pricing.buySoon')}</button>
  )
}
