---
// Starlight's search plus the "/" shortcut. Starlight only listens for Ctrl/Cmd+K.
import StarlightSearch from 'virtual:starlight/components/Search';
---

<StarlightSearch {...Astro.props} />

<script>
  // "/" opens the search like Ctrl+K. It does nothing while the user types in a field or while the dialog is open,
  // so the character can still be typed in the search box itself.
  window.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey) return;
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('input, textarea, select, [contenteditable="true"]')) return;
    const dialog = document.querySelector<HTMLDialogElement>('site-search dialog');
    if (!dialog || dialog.open) return;
    const openButton = document.querySelector<HTMLButtonElement>('button[data-open-modal]');
    // The button is disabled until Starlight's search script has run.
    if (!openButton || openButton.disabled) return;
    event.preventDefault();
    openButton.click();
  });
</script>
