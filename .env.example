# Development defaults: the settings a local developer usually needs. This is not the full list.
# Every key below is a declared field of Settings, which forbids unknown SIDEKICK_* keys, so a misspelled
# key stops the backend from starting. The complete set is listed in
# docs/reference/configuration.md; deploy/selfhost/selfhost.env.example shows the production set
# (GitHub OAuth for MCP sign-in, the companion app, push, rooms, time zone and license).
# Local seed data configuration lives in .env.seed (see .env.seed.example).
SIDEKICK_ENVIRONMENT=development
SIDEKICK_DATABASE_URL=postgresql+psycopg://sidekick_app:sidekick_app@localhost:55440/sidekick
SIDEKICK_CURSOR_SIGNING_SECRET=replace-with-at-least-32-random-characters
SIDEKICK_TOKEN_PEPPER=replace-with-a-different-32-character-secret

# Local encrypted backups are opt-in. Keep the Fernet key in a secret store or environment,
# never in the repository. External backup storage is intentionally not configured here.
SIDEKICK_BACKUP_ENABLED=false
SIDEKICK_BACKUP_DIRECTORY=/var/lib/sidekick/backups
SIDEKICK_BACKUP_ENCRYPTION_KEY=
SIDEKICK_BACKUP_RETENTION_COUNT=30
SIDEKICK_BACKUP_RETENTION_DAYS=30
# The newest N finished backups are never pruned; a new backup needs this percentage (at least 100) of the newest one free.
SIDEKICK_BACKUP_MIN_KEEP=5
SIDEKICK_BACKUP_SPACE_MARGIN_PCT=150
SIDEKICK_BACKUP_INTERVAL_SECONDS=86400

# Local stdio entrance for Claude Desktop (python -m sidekick.mcp.stdio): there is no bearer token, so the process
# acts as this one owner (a Sidekick user UUID) and refuses to start when it is empty or not an active user.
SIDEKICK_MCP_STDIO_OWNER_ID=

# Memory (off by default). Hindsight needs the base URL, token and derivation key together.
SIDEKICK_MEMORY_ENABLED=false
SIDEKICK_MEMORY_PROVIDER=fake
SIDEKICK_MEMORY_INGEST_ENABLED=true
# The orphan-bank sweep deletes Hindsight banks that no user derives. Turn it on only when this
# Hindsight server holds nothing else that matters, and no other Sidekick instance uses it.
SIDEKICK_MEMORY_ORPHAN_SWEEP_ENABLED=false
SIDEKICK_MEMORY_HINDSIGHT_BASE_URL=
SIDEKICK_MEMORY_HINDSIGHT_API_TOKEN=
SIDEKICK_MEMORY_ID_DERIVATION_KEY=
SIDEKICK_MEMORY_ALLOW_LOOPBACK=false
SIDEKICK_MEMORY_QUIET_SECONDS=600
SIDEKICK_MEMORY_DAILY_RETAIN_CAP=40
SIDEKICK_MEMORY_BACKFILL_DAILY_CAP=150
SIDEKICK_MEMORY_DAILY_CHAR_CAP=400000

# Hindsight's own model key is not a Sidekick setting: it is HINDSIGHT_API_LLM_API_KEY in the Hindsight env file
# (deploy/selfhost/hindsight.env.example).

# Companion adapter for the Android app (/companion/v1/). Off registers no route. See docs/operate/pair-android.md.
# Push is off by default too; deploy/selfhost/selfhost.env.example has the full push settings.
# SIDEKICK_COMPANION_ENABLED=false
# SIDEKICK_PUSH_ENABLED=false

# The rooms this instance shows (work cannot be left out), app language (sv or en) and the owner's time zone.
# SIDEKICK_ENABLED_ROOMS=work,journal,shopping,contacts,control
# SIDEKICK_MCP_APP_LOCALE=sv
# SIDEKICK_OWNER_TIMEZONE=Europe/Stockholm
